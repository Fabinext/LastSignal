# Steam account that owns SurrounDead (only used by the install service)
STEAM_USER=
STEAM_PASS=
# Steam Guard code if your account asks for one (otherwise leave empty)
STEAM_AUTH=
# Last Signal 0.10 needs the experimental branch (SurrounDead 0.8, UE 5.6)
STEAM_BETA=experimental
# UDP game port (also open it in your firewall/router)
SERVER_PORT=7777
